# ---- Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Somente servidor (criação/reset de usuários, seed de desenvolvimento). Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Google Sheets (FASE 3) — são SECRETS do Supabase, não variáveis do Next:
#   supabase secrets set GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
#   supabase secrets set GOOGLE_SPREADSHEET_ID=1AbC...
# Enquanto não configurados, a plataforma exibe "Configuração pendente" nas funções de sincronização.
